# Azure OpenAI
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Tools que continuam hospedadas no n8n. Não publique os URLs reais.
N8N_MCP_URL=https://your-n8n.example/mcp/replace-me
N8N_CATALOG_WEBHOOK_URL=https://your-n8n.example/webhook/get_tickets
N8N_OPEN_TICKET_WEBHOOK_URL=https://your-n8n.example/webhook/replace-me
N8N_BASIC_AUTH_USERNAME=replace-me
N8N_BASIC_AUTH_PASSWORD=replace-me

# Memória persistente opcional; sem isso, usa memória local durante o processo.
DATABASE_URL=
REQUEST_TIMEOUT_SECONDS=30

# Identidade para testes locais
DEV_SESSION_ID=local-dev
DEV_USER_NAME=Your Name
DEV_USER_EMAIL=you@example.com
